<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EFCoreVersion>11.0.0</EFCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="[$(EFCoreVersion),12.0.0)" />
    <PackageVersion Include="VistaDB.6" Version="6.6.2" />
  </ItemGroup>
</Project>
